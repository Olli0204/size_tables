<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Größentabellen</Name>
    <Description>Einbindung von Größentabellen in den Onlineshop.</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.2.4</MinShopVersion>
    <MaxShopVersion>5.7.0</MaxShopVersion>
    <PluginID>size_tables</PluginID>
    <Version>1.2.2</Version>
    <CreateDate>2024-02-27</CreateDate>
    <Install>
        <Adminmenu>
            <Customlink sort="10">
                <Name>Ein Neuer Tab</Name>
            </Customlink>
            <Customlink sort="11">
                <Name>Synchronisieren</Name>
            </Customlink>
            
            <Settingslink sort="3">
                <Name>Einstellungen</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Allgemein</Name>
                    <Description>Allgemeine Einstellungen des Plugins</Description>
                    <ValueName>Spacer</ValueName>
                </Setting>
                <Setting type="checkbox" sort="1" conf="Y">
                    <Name>Plugin Aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie das Plugin aktiv.</Description>
                    <ValueName>size_tables_active</ValueName>
                </Setting>
                <Setting type="checkbox" sort="2" conf="Y">
                    <Name>Für Mobile aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie das Plugin für Mobilgeräte aktiv.</Description>
                    <ValueName>size_tables_mobile_active</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="1" sort="3" conf="Y" multiple="Y">
                    <Name>Warengruppen für Schuhe</Name>
                    <Description>Wähle die passenden Warengruppen aus.</Description>
                    <ValueName>size_tables_values</ValueName>
                    <OptionsSource>
                        <File>warengruppen.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">Leider fehlgeschlagen</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="checkbox" sort="4" conf="Y">
                    <Name>Name auf Button Aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie den Text im Button ein.</Description>
                    <ValueName>size_tables_name_active</ValueName>
                </Setting>
                <Setting type="text" initialValue="" sort="5" conf="N">
                    <Name>Größentabellen für Bindungen</Name>
                    <ValueName>Spacer2</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="1" sort="6" conf="Y" multiple="Y">
                    <Name>Warengruppen für Bindungen</Name>
                    <Description>Wähle die passenden Warengruppen aus.</Description>
                    <ValueName>size_tables_values_bindings</ValueName>
                    <OptionsSource>
                        <File>warengruppen.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">Leider fehlgeschlagen</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="1" sort="7" conf="Y">
                    <Name>Warengruppe für Bindungen Männer</Name>
                    <Description>Wähle die passenden Warengruppen aus.</Description>
                    <ValueName>size_tables_values_bindings_men</ValueName>
                    <OptionsSource>
                        <File>warengruppen.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">Leider fehlgeschlagen</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="1" sort="8" conf="Y">
                    <Name>Warengruppe für Bindungen Frauen</Name>
                    <Description>Wähle die passenden Warengruppen aus.</Description>
                    <ValueName>size_tables_values_bindings_women</ValueName>
                    <OptionsSource>
                        <File>warengruppen.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">Leider fehlgeschlagen</Option>
                    </SelectboxOptions>
                </Setting>
            </Settingslink>
            
        </Adminmenu>
        <Locales>
            <Variable>
                <Name>size_heading</Name>
                <Description>Überschrift der Tabelle</Description>
                <VariableLocalized iso="GER">Größentabelle</VariableLocalized>
                <VariableLocalized iso="ENG">Size Table</VariableLocalized>
            </Variable>
            <Variable>
                <Name>warning_bindings</Name>
                <Description>Warnung für Bindungsangaben</Description>
                <VariableLocalized iso="GER">Achtung: Herstellerangabe - Werte stimmen nur bei Boots der gleichen Hersteller!</VariableLocalized>
                <VariableLocalized iso="ENG">Note: Manufacturer's specification - values are only correct for boots from the same manufacturer!</VariableLocalized>
            </Variable>
        </Locales>
    </Install>
</jtlshopplugin>