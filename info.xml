<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Größentabellen</Name>
    <Description>Einbindung von Größentabellen in den Onlineshop.</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.2.4</MinShopVersion>
    <MaxShopVersion>5.7.0</MaxShopVersion>
    <PluginID>size_tables</PluginID>
    <Version>1.3.4</Version>
    <CreateDate>2024-02-27</CreateDate>
    <Install>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Größentabellen</Name>
            </Customlink>

            <Settingslink sort="2">
                <Name>Einstellungen</Name>
                <Setting type="selectbox" initialValue="N" sort="1" conf="Y">
                    <Name>Plugin Aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie das Plugin aktiv.</Description>
                    <ValueName>size_tables_active</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="0">Ja</Option>
                        <Option value="N" sort="1">Nein</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="N" sort="2" conf="Y">
                    <Name>Für Mobile aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie das Plugin für Mobilgeräte aktiv.</Description>
                    <ValueName>size_tables_mobile_active</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="0">Ja</Option>
                        <Option value="N" sort="1">Nein</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="N" sort="3" conf="Y">
                    <Name>Name auf Button Aktiv</Name>
                    <Description>Mit dieser Einstellung schalten sie den Text im Button ein.</Description>
                    <ValueName>size_tables_name_active</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="0">Ja</Option>
                        <Option value="N" sort="1">Nein</Option>
                    </SelectboxOptions>
                </Setting>
            </Settingslink>
            
        </Adminmenu>
        <FrontendLink>
            <Link>
                <Filename>groessentabellen.php</Filename>
                <Name>Groessentabellen</Name>
                <Template>groessentabellen.tpl</Template>
                <VisibleAfterLogin>N</VisibleAfterLogin>
                <PrintButton>N</PrintButton>
                <NoFollow>N</NoFollow>
                <Identifier>sizeTablesOverview</Identifier>
                <SSL>2</SSL>
                <LinkLanguage iso="GER">
                    <Seo>groessentabellen</Seo>
                    <Name>Groessentabellen</Name>
                    <Title>Gr&#246;&#223;entabellen</Title>
                    <MetaTitle>Gr&#246;&#223;entabellen</MetaTitle>
                    <MetaKeywords>Groessentabelle, Schuhgroesse, Bindung</MetaKeywords>
                    <MetaDescription>Alle Groessentabellen fuer Snowboard-Schuhe und Bindungen</MetaDescription>
                </LinkLanguage>
                <LinkLanguage iso="ENG">
                    <Seo>size-tables</Seo>
                    <Name>Size Tables</Name>
                    <Title>Size Tables</Title>
                    <MetaTitle>Size Tables</MetaTitle>
                    <MetaKeywords>size table, shoe size, binding</MetaKeywords>
                    <MetaDescription>All size tables for snowboard boots and bindings</MetaDescription>
                </LinkLanguage>
            </Link>
        </FrontendLink>
        <Locales>
            <Variable>
                <Name>size_heading</Name>
                <Description>Überschrift der Tabelle</Description>
                <VariableLocalized iso="GER">Größentabelle</VariableLocalized>
                <VariableLocalized iso="ENG">Size Table</VariableLocalized>
            </Variable>
            <Variable>
                <Name>warning_bindings</Name>
                <Description>Warnung für Bindungsangaben</Description>
                <VariableLocalized iso="GER">Achtung: Herstellerangabe - Werte stimmen nur bei Boots der gleichen Hersteller!</VariableLocalized>
                <VariableLocalized iso="ENG">Note: Manufacturer's specification - values are only correct for boots from the same manufacturer!</VariableLocalized>
            </Variable>
        </Locales>
    </Install>
</jtlshopplugin>